    \preformatted{LensViewer$describe(by = NULL, top = 10L)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{by}}{Metadata column to break the selection down by (pushed
with \code{push_metadata()}); categories are counted, numbers summarised}
      \item{\code{top}}{Number of categories to list}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A \code{lens_description} list; printing it gives the summary.
  }
}

