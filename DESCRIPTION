Package: GiottoLens
Title: Interactive Spatial Biology Viewer for GiottoDisk Data
Version: 0.1.0
Authors@R: c(
	person("Ruben", "Dries", email = "rubendries@gmail.com",
		 role = c("aut", "cre"), comment = c(ORCID = "0000-0001-7650-7754")),
	person("Jiaji", "George Chen", email = "jiajic@bu.edu",
		 role = c("aut"))
